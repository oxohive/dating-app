# Application
APP_NAME=dating-app-backend
ENVIRONMENT=local
DEBUG=false

# Database (PostgreSQL + PostGIS in production; a driver such as
# psycopg2-binary must be installed separately to actually connect)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/dating_app

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Correlation ID
CORRELATION_ID_HEADER=X-Correlation-ID

# Tracing (console exporter locally; swap for X-Ray/CloudWatch in infra/)
OTEL_SERVICE_NAME=dating-app-backend
OTEL_EXPORTER=console

# Auth / JWT secrets (replace in every non-local environment; never commit real values)
JWT_SECRET_KEY=changeme-local-only
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Notifications
FCM_SERVER_KEY=
