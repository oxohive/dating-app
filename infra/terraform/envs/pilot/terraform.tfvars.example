# Copy this to terraform.tfvars and fill in real values before any real
# plan/apply. terraform.tfvars itself should stay out of version control
# (see the repo root .gitignore, owned by another part of this project).
#
# PLACEHOLDER VALUES ONLY BELOW — none of this is a real account ID,
# bucket name, email, or secret.

aws_region = "ap-south-1"

# Leave null/[] to use the account's default VPC/subnets.
vpc_id     = null
subnet_ids = []

instance_type            = "t3.medium"
ssh_allowed_cidr_blocks  = [] # e.g. ["203.0.113.4/32"] for a single office IP; empty = SSM only
http_ingress_cidr_blocks = ["0.0.0.0/0"]
root_volume_size_gb      = 30

# Bucket names must be globally unique across all of S3.
media_bucket_name    = "example-dating-app-pilot-media"
backup_bucket_name   = "example-dating-app-pilot-backups"
artifact_bucket_name = "example-dating-app-pilot-artifacts"

github_org  = "oxohive"
github_repo = "dating-app"

create_oidc_provider       = true
existing_oidc_provider_arn = null
ecr_repository_name        = "dating-app-backend"

alert_emails = ["alerts@example.com"]

budget_limit_amount   = 5000
budget_limit_currency = "INR"

log_retention_days = 30

# EventBridge cron expressions are UTC. Defaults below are 00:00 IST stop,
# 08:00 IST start (IST = UTC+5:30, no DST).
stop_schedule_cron  = "cron(30 18 * * ? *)"
start_schedule_cron = "cron(30 2 * * ? *)"
schedule_enabled    = true

cognito_enabled = false
